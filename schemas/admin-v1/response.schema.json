{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-ascension.invalid/schemas/watchdog-admin-v1/response.schema.json",
  "title": "watchdog-admin-v1 response",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "request_id", "idempotency_key", "status", "result", "health"],
  "properties": {
    "contract": {"const": "watchdog-admin-v1"},
    "request_id": {"type": "string", "maxLength": 128},
    "idempotency_key": {"type": "string", "maxLength": 128},
    "status": {"enum": ["OK", "ACCEPTED", "UNAUTHORIZED", "FORBIDDEN", "INVALID", "BOUNDS_EXCEEDED", "BUSY", "IN_PROGRESS", "CONFLICT", "NOT_FOUND", "PERSISTENCE_UNAVAILABLE", "UNSUPPORTED", "TIMEOUT", "INTERNAL"]},
    "result": {"oneOf": [{"$ref": "#/$defs/status"}, {"$ref": "#/$defs/jobs"}, {"$ref": "#/$defs/attempt"}, {"$ref": "#/$defs/accepted"}, {"$ref": "#/$defs/backup"}, {"$ref": "#/$defs/restore"}, {"$ref": "#/$defs/release"}, {"$ref": "#/$defs/release_activation"}, {"type": "null"}]},
    "health": {"$ref": "#/$defs/health"}
  },
  "$defs": {
    "health": {"type": "object", "additionalProperties": false, "required": ["phase", "ready", "heartbeat_seq", "progress_age_ms", "phase_deadline_at_ms", "queue_depth", "oldest_queue_age_ms", "pending_operations", "instance_incarnation", "lease_remaining_ms"], "properties": {"phase": {"enum": ["starting", "reconciling", "draining", "paused", "blocked", "stopped"]}, "ready": {"type": "boolean"}, "heartbeat_seq": {"type": "integer", "minimum": 0}, "progress_age_ms": {"type": ["integer", "null"], "minimum": 0}, "phase_deadline_at_ms": {"type": ["integer", "null"], "minimum": 0}, "queue_depth": {"type": "integer", "minimum": 0, "maximum": 64}, "oldest_queue_age_ms": {"type": ["integer", "null"], "minimum": 0}, "pending_operations": {"type": "integer", "minimum": 0}, "instance_incarnation": {"type": ["string", "null"], "maxLength": 128}, "lease_remaining_ms": {"type": ["integer", "null"], "minimum": 0}}},
    "status": {"type": "object", "additionalProperties": false, "required": ["kind", "value"], "properties": {"kind": {"const": "Status"}, "value": {"type": "object", "additionalProperties": false, "required": ["desired_mode", "health", "jobs_queued", "jobs_running", "jobs_completed", "jobs_quarantined", "restart_generation", "config_digest", "approved_release_digest"], "properties": {"desired_mode": {"enum": ["stopped", "starting", "running", "suspect", "draining", "recovering", "backoff", "paused", "blocked", "quarantined", "waiting_for_session"]}, "health": {"$ref": "#/$defs/health"}, "jobs_queued": {"type": "integer", "minimum": 0}, "jobs_running": {"type": "integer", "minimum": 0}, "jobs_completed": {"type": "integer", "minimum": 0}, "jobs_quarantined": {"type": "integer", "minimum": 0}, "restart_generation": {"type": "integer", "minimum": 0}, "config_digest": {"pattern": "^[0-9a-f]{64}$"}, "approved_release_digest": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}}}}},
    "jobs": {"type": "object", "additionalProperties": false, "required": ["kind", "value"], "properties": {"kind": {"const": "Jobs"}, "value": {"type": "object", "additionalProperties": false, "required": ["jobs", "truncated"], "properties": {"jobs": {"type": "array", "maxItems": 256, "items": {"type": "object", "additionalProperties": false, "required": ["id", "kind", "status", "attempt_count", "created_at_ms", "next_retry_at_ms"], "properties": {"id": {"type": "string", "maxLength": 128}, "kind": {"type": "string", "maxLength": 128}, "status": {"enum": ["queued", "running", "completed", "failed", "quarantined"]}, "attempt_count": {"type": "integer", "minimum": 0}, "created_at_ms": {"type": "integer", "minimum": 0}, "next_retry_at_ms": {"type": ["integer", "null"], "minimum": 0}}}}, "truncated": {"type": "boolean"}}}}},
    "attempt": {"type": "object", "additionalProperties": false, "required": ["kind", "value"], "properties": {"kind": {"const": "Attempt"}, "value": {"type": "object", "additionalProperties": false, "required": ["attempt_id", "job_id", "sequence", "status", "started_at_ms", "finished_at_ms"], "properties": {"attempt_id": {"type": "string", "maxLength": 128}, "job_id": {"type": "string", "maxLength": 128}, "sequence": {"type": "integer", "minimum": 0}, "status": {"enum": ["running", "completed", "failed", "unknown", "quarantined"]}, "started_at_ms": {"type": "integer", "minimum": 0}, "finished_at_ms": {"type": ["integer", "null"], "minimum": 0}}}}},
    "accepted": {"type": "object", "additionalProperties": false, "required": ["kind", "value"], "properties": {"kind": {"const": "Accepted"}, "value": {"type": "object", "additionalProperties": false, "required": ["command", "queued"], "properties": {"command": {"type": "string"}, "queued": {"type": "boolean"}}}}},
    "backup": {"type": "object", "additionalProperties": false, "required": ["kind", "value"], "properties": {"kind": {"const": "Backup"}, "value": {"type": "object", "additionalProperties": false, "required": ["backup_id", "durable"], "properties": {"backup_id": {"type": "string", "maxLength": 128}, "durable": {"type": "boolean"}}}}},
    "restore": {"type": "object", "additionalProperties": false, "required": ["kind", "value"], "properties": {"kind": {"const": "Restore"}, "value": {"type": "object", "additionalProperties": false, "required": ["backup_id", "rekeyed", "blocked_until_fenced"], "properties": {"backup_id": {"type": "string", "maxLength": 128}, "rekeyed": {"const": true}, "blocked_until_fenced": {"const": true}}}}},
    "release": {"type": "object", "additionalProperties": false, "required": ["kind", "value"], "properties": {"kind": {"const": "ReleaseInspection"}, "value": {"type": "object", "additionalProperties": false, "required": ["release_id", "release_digest", "compatible", "active"], "properties": {"release_id": {"type": "string", "maxLength": 128}, "release_digest": {"pattern": "^[0-9a-f]{64}$"}, "compatible": {"type": "boolean"}, "active": {"type": "boolean"}}}}},
    "release_activation": {"type": "object", "additionalProperties": false, "required": ["kind", "value"], "properties": {"kind": {"const": "ReleaseActivation"}, "value": {"type": "object", "additionalProperties": false, "required": ["release_id", "release_digest", "previous_release_id", "previous_release_digest", "rollback"], "properties": {"release_id": {"type": "string", "maxLength": 128}, "release_digest": {"pattern": "^[0-9a-f]{64}$"}, "previous_release_id": {"type": ["string", "null"], "maxLength": 128}, "previous_release_digest": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}, "rollback": {"type": "boolean"}}}}}
  }
}
