{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-ascension.github.io/standards/schemas/repositories.schema.json",
  "title": "AI-Ascension repository profile map",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "refreshed", "source", "repositories"],
  "properties": {
    "schema_version": {"const": 1},
    "refreshed": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "source": {"type": "string", "minLength": 1},
    "repositories": {"type": "array", "minItems": 13, "items": {"$ref": "#/$defs/repository"}}
  },
  "$defs": {
    "repository": {"type": "object", "additionalProperties": false, "required": ["repository", "repository_id", "node_id", "default_branch", "baseline_commit", "owner", "profile_id", "adoption", "language_scopes", "exclusion_reason"], "properties": {"repository": {"type": "string", "pattern": "^AI-Ascension/[A-Za-z0-9._-]+$"}, "repository_id": {"type": "integer", "minimum": 1}, "node_id": {"type": "string", "pattern": "^R_kg[A-Za-z0-9_-]+$"}, "default_branch": {"type": "string", "minLength": 1}, "baseline_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "owner": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,15}$"}, "profile_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,48}$"}, "adoption": {"enum": ["ready", "prepared", "excluded"]}, "language_scopes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"}}, "exclusion_reason": {"type": ["string", "null"]}}}
  }
}
