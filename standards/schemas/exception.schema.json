{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-ascension.github.io/standards/schemas/exception.schema.json",
  "title": "AI-Ascension standards exception",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "rule_ids", "paths", "owner", "rationale", "compensating_tests", "approval", "reviewed_on", "expires_on", "removal_criteria"],
  "properties": {
    "id": {"type": "string", "pattern": "^EXC-[A-Z0-9]+-[0-9]{3}$"},
    "rule_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^(X|RUST|MANAGED|WEB|OPS|DOC)-[A-Z0-9]+-[0-9]{3}$"}},
    "paths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$"}},
    "owner": {"type": "string", "minLength": 1},
    "rationale": {"type": "string", "minLength": 20},
    "compensating_tests": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "approval": {"type": "object", "additionalProperties": false, "required": ["reviewer", "record", "status"], "properties": {"reviewer": {"type": "string", "minLength": 1}, "record": {"type": "string", "pattern": "^(https://github.com/AI-Ascension/[A-Za-z0-9._-]+/(?:issues|pull)/[0-9]+|local-review:[A-Za-z0-9._/-]+)$"}, "status": {"const": "approved"}}},
    "reviewed_on": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "expires_on": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "removal_criteria": {"type": "string", "minLength": 10}
  }
}
