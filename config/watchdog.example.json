{
  "schema_version": 1,
  "deployment_id": "example-local",
  "database": "/var/lib/ascension-watchdog/watchdog.sqlite3",
  "desired_mode": "stopped",
  "probe_interval_ms": 2000,
  "suspect_threshold": 3,
  "startup_grace_secs": 90,
  "lease_ttl_secs": 30,
  "lease_renewal_secs": 10,
  "restart_backoff_base_secs": 1,
  "restart_backoff_cap_secs": 60,
  "restart_budget_count": 5,
  "restart_budget_window_secs": 600,
  "max_unresolved_operations": 1,
  "max_payload_bytes": 65536,
  "max_jobs": 1024,
  "provider_timeout_secs": 120,
  "components": [],
  "allow_synthetic_children": false
}
