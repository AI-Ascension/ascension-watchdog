[Unit]
Description=AI-Ascension deterministic deployment watchdog
Wants=network-online.target
After=network-online.target local-fs.target

[Service]
Type=notify
NotifyAccess=main
User=ascension-watchdog
Group=ascension-watchdog
ExecStart=/opt/ascension-watchdog/current/watchdog daemon --config /etc/ascension-watchdog/watchdog.json
Restart=on-failure
RestartSec=5s
WatchdogSec=30s
TimeoutStartSec=120s
TimeoutStopSec=45s
KillMode=control-group
Delegate=yes
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
StateDirectory=ascension-watchdog
ConfigurationDirectory=ascension-watchdog
ReadWritePaths=/var/lib/ascension-watchdog
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictSUIDSGID=yes
TasksMax=128
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
