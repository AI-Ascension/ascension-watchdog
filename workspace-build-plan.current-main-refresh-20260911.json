{
  "schema_version": 2,
  "classification": "current-main-refresh-build-and-conformance-not-activated",
  "purpose": "Declarative locked build and conformance commands for the admitted current-main source set. A passing run is component/compile evidence only: not an installed service, activation, live-host, reboot, rollback, or soak result.",
  "toolchain": "1.97.1",
  "repositories": {
    "ascension-watchdog": [
      {
        "name": "build",
        "program": "cargo",
        "args": [
          "+{toolchain}",
          "build",
          "--locked",
          "--release"
        ],
        "env": {
          "CARGO_TARGET_DIR": "{scratch}/target"
        },
        "timeout_seconds": 3600
      },
      {
        "name": "schema-conformance",
        "program": "cargo",
        "args": [
          "+{toolchain}",
          "test",
          "--locked",
          "-p",
          "watchdog-fault-fixture",
          "--test",
          "schema"
        ],
        "env": {
          "CARGO_TARGET_DIR": "{scratch}/target"
        },
        "timeout_seconds": 3600
      }
    ],
